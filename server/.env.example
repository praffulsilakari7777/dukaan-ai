# Fill in ONE option. This file (.env) and any service-account*.json are never committed.

# Option A (recommended): Google Cloud service account JSON with the "Vertex AI User" role.
# Put the file at server/service-account.json and keep this line:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: Vertex AI API key (express mode)
# VERTEX_API_KEY=

# Option C: Gemini API key from aistudio.google.com
# GEMINI_API_KEY=
